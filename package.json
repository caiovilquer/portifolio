{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://vilquer.dev",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:ssr && npm run prerender",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .ssr",
    "prerender": "node scripts/prerender.mjs",
    "check": "npm run build && npm run seo:audit && tsc --noEmit",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "postdeploy": "npm run seo:submit",
    "seo:audit": "node scripts/audit-seo.mjs",
    "seo:submit": "node scripts/submit-indexnow.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^6.1.0",
    "gh-pages": "^6.3.0",
    "typescript": "^5.1.6",
    "vite": "^8.2.2"
  }
}
